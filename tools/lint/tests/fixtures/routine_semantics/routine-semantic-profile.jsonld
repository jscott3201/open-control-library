  "@id": "urn:open-control-library:routine-semantic-profile:G36-05-16-SYNTHETIC-SEMANTIC-TEST:v1",
  "@type": "ocl:RoutineSemanticProfile",
  "schema": "cxf-library/routine-semantic-profile/v1",
  "canonical_id": "G36-05-16-SYNTHETIC-SEMANTIC-TEST",
  "revision": 1,
  "ontology_pins": "routines/ontology/ontology-pins.json",
  "connector_roles": [
    {
      "@id": "urn:open-control-library:connector-role:G36-05-16-SYNTHETIC-SEMANTIC-TEST:zone_air_temperatures",
      "@type": "ocl:ConnectorSemanticRole",
      "connector_id": "zone_air_temperatures",
      "direction": "input",
      "requirement": "R",
      "semantic_role": "Zone air temperature observations used by the synthetic aggregate.",
      "mapping_status": "verified",
      "topology_requirements": [
        "Each bound sensor must observe the zone identified by its stable member."
      ],
      "cardinality": {"minimum": 2, "maximum": 3},
      "binding": {
        "@type": "ocl:PhysicalPointBinding",
        "kind": "physical-or-bms-point",
        "canonical_point_ref": "points/synthetic.points.json#zone_air_temperature",
        "brick_mapping": {
          "brick_class": "brick:Zone_Air_Temperature_Sensor"
        },
        "s223_mapping": {
          "property_class": "s223:QuantifiableObservableProperty",
          "quantity_kind": "qk:Temperature",
          "qudt_unit": "unit:DEG_C",
          "medium": "s223:Fluid-Air",
          "aspects": []
        }
      }
    },
    {
      "@id": "urn:open-control-library:connector-role:G36-05-16-SYNTHETIC-SEMANTIC-TEST:zone_cooling_setpoint",
      "@type": "ocl:ConnectorSemanticRole",
      "connector_id": "zone_cooling_setpoint",
      "direction": "input",
      "requirement": "R",
      "semantic_role": "Active zone cooling setpoint consumed by the synthetic routine.",
      "mapping_status": "provisional",
      "topology_requirements": [
        "The setpoint must control the same zone identified by the bound point owner."
      ],
      "cardinality": {"minimum": 1, "maximum": 1},
      "binding": {
        "@type": "ocl:PhysicalPointBinding",
        "kind": "physical-or-bms-point",
        "canonical_point_ref": "points/synthetic.points.json#zone_cooling_setpoint",
        "brick_mapping": {
          "brick_class": "brick:Zone_Air_Cooling_Temperature_Setpoint"
        },
        "s223_mapping": {
          "property_class": "s223:QuantifiableActuatableProperty",
          "quantity_kind": "qk:Temperature",
          "qudt_unit": "unit:DEG_C",
          "medium": "s223:Fluid-Air",
          "aspects": ["s223:Aspect-Setpoint"]
        }
      }
    },
    {
      "@id": "urn:open-control-library:connector-role:G36-05-16-SYNTHETIC-SEMANTIC-TEST:system_mode",
      "@type": "ocl:ConnectorSemanticRole",
      "connector_id": "system_mode",
      "direction": "input",
      "requirement": "S",
      "semantic_role": "System operating mode consumed by the synthetic routine.",
      "mapping_status": "verified",
      "topology_requirements": [],
      "cardinality": {"minimum": 1, "maximum": 1},
      "binding": {
        "@type": "ocl:SoftwareSignalBinding",
        "kind": "software-signal",
        "local_class": "ocl:SoftwareSignal"
      }
    },
    {
      "@id": "urn:open-control-library:connector-role:G36-05-16-SYNTHETIC-SEMANTIC-TEST:zone_air_temperature_max",
      "@type": "ocl:ConnectorSemanticRole",
      "connector_id": "zone_air_temperature_max",
      "direction": "input",
      "requirement": "D",
      "semantic_role": "Maximum zone air temperature derived for routine logic.",
      "mapping_status": "verified",
      "topology_requirements": [],
      "cardinality": {"minimum": 1, "maximum": 1},
      "binding": {
        "@type": "ocl:DerivedSignalBinding",
        "kind": "derived-signal",
        "local_class": "ocl:DerivedAggregate",
        "output_id": "zone_air_temperature_max",
        "derivation_manifest_ref": "routine-derivation-manifest.jsonld#zone_air_temperature_max"
